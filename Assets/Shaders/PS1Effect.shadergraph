    "m_SourceType": 1,
    "m_FunctionName": "PS1Quantize",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 c = Color * Levels;\r\nc = c + (DitherThreshold - 0.5);\r\nc = floor(c + 0.5);\r\nOutColor = saturate(c / Levels);"
}

